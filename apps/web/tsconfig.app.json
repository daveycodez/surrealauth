{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/web",
    "tsBuildInfoFile": "out-tsc/web/tsconfig.app.tsbuildinfo",
    "rootDir": ".",
    "importHelpers": false,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/types/schema.json", "vite.config.ts"],
  "references": [
    {
      "path": "../../packages/react/tsconfig.lib.json"
    }
  ]
}
