# SurrealKit connection to the surrealauth SurrealDB Earth instance.
# Copy to .env and fill in SURREALDB_PASSWORD (never commit .env).
SURREALDB_HOST=wss://06h01ki929o216lckkdmj1d92c.surrealdb.earth
SURREALDB_NAMESPACE=main
SURREALDB_NAME=main
SURREALDB_AUTH_LEVEL=database
